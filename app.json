{
  "expo": {
    "name": "2Mots",
    "slug": "2Mots",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/Splash-Center.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF7F50"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.afbstudio.twomots",
      "versionCode": 5,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF7F50"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF7F50",
          "sounds": []
        }
      ],
      "expo-web-browser"
    ]
  }
}